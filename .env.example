# Copy this to .env and fill in the values.
# .env is gitignored — never commit secrets.

# ── Required ──────────────────────────────────
# X (Twitter) API Bearer Token
IRAN_WATCHER_X_BEARER_TOKEN=

# ── Redis ─────────────────────────────────────
# Hostname/IP of Redis as seen from the shared Docker network.
# Typically the service name defined in your Redis stack.
IRAN_WATCHER_REDIS_ADDR=redis:6379
IRAN_WATCHER_REDIS_PASSWORD=
IRAN_WATCHER_REDIS_DB=0

# Name of the external Docker network your Redis stack exposes.
# Run `docker network ls` to find it (usually <stack-name>_default).
REDIS_NETWORK=redis_default

# ── Logging ───────────────────────────────────
IRAN_WATCHER_LOG_FORMAT=json
IRAN_WATCHER_LOG_LEVEL=info

# ── Pushover (optional) ───────────────────────
IRAN_WATCHER_PUSHOVER_APP_TOKEN=
IRAN_WATCHER_PUSHOVER_USER_KEY=
