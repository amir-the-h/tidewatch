# Copy this to .env and fill in the values.
# .env is gitignored — never commit secrets.

# ── Required ──────────────────────────────────
# X (Twitter) API Bearer Token
TIDEWATCH_X_BEARER_TOKEN=

# ── Redis ─────────────────────────────────────
# Hostname/IP of Redis as seen from the shared Docker network.
# Typically the service name defined in your Redis stack.
TIDEWATCH_REDIS_ADDR=redis:6379
TIDEWATCH_REDIS_PASSWORD=
TIDEWATCH_REDIS_DB=0

# Name of the external Docker network your Redis stack exposes.
# Run `docker network ls` to find it (usually <stack-name>_default).
REDIS_NETWORK=redis_default

# ── Logging ───────────────────────────────────
TIDEWATCH_LOG_FORMAT=json
TIDEWATCH_LOG_LEVEL=info

# ── Pushover (optional) ───────────────────────
TIDEWATCH_PUSHOVER_APP_TOKEN=
TIDEWATCH_PUSHOVER_USER_KEY=

# ── Auth (required) ───────────────────────────
# Generate with: openssl rand -hex 32
TIDEWATCH_AUTH_JWT_SECRET=
TIDEWATCH_AUTH_ADMIN_USERNAME=admin
TIDEWATCH_AUTH_ADMIN_PASSWORD=
